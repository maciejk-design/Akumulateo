# ==============================================================================
# Akumulateo – Konfiguracja Środowiskowa Integracji Analitycznych (GSC, GA4, PSI)
# Skopiuj ten plik jako .env i uzupełnij swoimi wartościami.
# NIGDY NIE COMMITUJ PLIKU .env DO REPOZYTORIUM GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Service Account (Dostęp do Search Console i GA4)
# ------------------------------------------------------------------------------
# Ścieżka do pobranego pliku JSON klucza Service Account:
GOOGLE_SERVICE_ACCOUNT_KEY_PATH="./service-account.json"

# Alternatywnie: zawartość klucza JSON zakodowana w Base64 (przydatne w CI/CD lub Docker):
# GOOGLE_SERVICE_ACCOUNT_BASE64=""

# ------------------------------------------------------------------------------
# 2. Google Search Console (GSC)
# ------------------------------------------------------------------------------
# URL witryny w GSC (dokładnie tak jak w Search Console, np. prefiks URL lub domena):
# Dla usługi z prefiksem URL:
GOOGLE_SEARCH_CONSOLE_SITE_URL="https://www.akumulateo.pl/"
# Dla usługi domenowej:
# GOOGLE_SEARCH_CONSOLE_SITE_URL="sc-domain:akumulateo.pl"

# ------------------------------------------------------------------------------
# 3. Google Analytics 4 (GA4)
# ------------------------------------------------------------------------------
# Identyfikator usługi GA4 (Property ID - cyfrowy, znajdziesz w Administracja -> Szczegóły usługi):
GA4_PROPERTY_ID="123456789"

# ------------------------------------------------------------------------------
# 4. Google PageSpeed Insights (PSI)
# ------------------------------------------------------------------------------
# Domyślny URL do regularnych audytów:
PAGESPEED_TARGET_URL="https://www.akumulateo.pl/"

# Opcjonalny klucz Google Cloud API Key (zwiększa limit zapytań z 25 000/dzień, ale bez klucza też działa):
GOOGLE_PAGESPEED_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Domyślne Ustawienia Biznesowe Akumulateo
# ------------------------------------------------------------------------------
# Numer alarmowy 24h:
EMERGENCY_PHONE="+48696556446"
# Minimalny zysk netto na zleceniu (PLN):
MIN_ACCEPTABLE_PROFIT_PLN="180"
# Dopłata za zgłoszenie nocne 22:00-06:00 (PLN):
NIGHT_SURCHARGE_PLN="80"
